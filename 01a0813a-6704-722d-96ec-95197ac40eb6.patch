@@ -0,0 +1,34 @@
+package com.vexcompany.samvira.security.keystore
+
+import java.util.Base64
+
+/**
+ * Pure PEM (RFC 7468) encoding for public keys.
+ *
+ * Kept free of Android dependencies so the serialization format can be
+ * unit-tested on the JVM and reused by any future non-Android consumer.
+ */
+object Pem {
+
+    private const val LINE_LENGTH = 64
+
+    /** Encodes a DER-encoded SubjectPublicKeyInfo as a "PUBLIC KEY" PEM block. */
+    fun encodePublicKey(der: ByteArray): String = encode("PUBLIC KEY", der)
+
+    /** Encodes [der] as a PEM block of the given [type] (e.g. "PUBLIC KEY"). */
+    fun encode(type: String, der: ByteArray): String {
+        val body = Base64.getEncoder()
+            .encodeToString(der)
+            .chunked(LINE_LENGTH)
+            .joinToString("\n")
+        return buildString {
+            append("-----BEGIN ")
+            append(type)
+            append("-----\n")
+            append(body)
+            append("\n-----END ")
+            append(type)
+            append("-----\n")
+        }
+    }
+}
