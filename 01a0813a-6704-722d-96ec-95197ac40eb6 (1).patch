+
+val LightSurface = Color(0xFFF7F9FC)
+val LightOnSurface = Color(0xFF1B1F27)
+val LightSurfaceVariant = Color(0xFFE3E8F0)
+
+val DarkSurface = Color(0xFF12141A)
