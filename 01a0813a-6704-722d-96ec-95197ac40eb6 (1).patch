+    override suspend fun save(record: InstallationIdentityRecord) {
+        dataStore.edit { prefs ->
+            prefs[KEY_INSTALLATION_ID] = record.installationId
+            prefs[KEY_CREATED_AT] = record.createdAtEpochMs
