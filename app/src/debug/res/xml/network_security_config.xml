<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security policy.

  Cleartext HTTP is permitted for the Android emulator's host alias (10.0.2.2)
  so the debug build can talk to a locally running backend during development.
  Everything else keeps the platform default (cleartext blocked). Release
  builds never see this config and ship with an empty API_BASE_URL.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
